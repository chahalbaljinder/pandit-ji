# ============================================
# BookMyPanditJi API - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# All values marked REQUIRED must be provided

# ------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------
# DATABASE (PostgreSQL) - REQUIRED
# ------------------------------------------------------------------
# Local Docker: postgresql://postgres:postgres@localhost:5432/bookmypanditji
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookmypanditji

# ------------------------------------------------------------------
# REDIS - REQUIRED (for caching, sessions, queues, websockets)
# ------------------------------------------------------------------
# Local Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------
# AUTHENTICATION - REQUIRED
# ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Optional: MFA
MFA_ISSUER=BookMyPanditJi

# ------------------------------------------------------------------
# PAYMENT GATEWAYS (Free tier available)
# ------------------------------------------------------------------
# Razorpay (India) - Free tier: https://razorpay.com/pricing/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (International) - Free tier: https://stripe.com/pricing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# EMAIL (Free tiers available)
# ------------------------------------------------------------------
# Option 1: Nodemailer with Gmail (free)
# Enable "Less secure apps" or use App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@bookmypanditji.com

# Option 2: SendGrid (100 emails/day free)
# SENDGRID_API_KEY=
# EMAIL_FROM=verified-sender@yourdomain.com

# Option 3: Mailgun (5,000 emails/month free for 3 months)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# ------------------------------------------------------------------
# SMS / WHATSAPP (Free tiers available)
# ------------------------------------------------------------------
# Twilio (Free trial credit): https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Alternative: Msg91 (India) - Free credits on signup
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=

# Alternative: Gupshup (WhatsApp Business API)
# GUPSHUP_API_KEY=
# GUPSHUP_APP_NAME=

# ------------------------------------------------------------------
# PUSH NOTIFICATIONS (Free)
# ------------------------------------------------------------------
# Firebase Cloud Messaging (Free): https://firebase.google.com/pricing
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OneSignal (Free tier): https://onesignal.com/pricing
# ONESIGNAL_APP_ID=
# ONESIGNAL_API_KEY=

# ------------------------------------------------------------------
# FILE STORAGE (Free tiers available)
# ------------------------------------------------------------------
# Option 1: AWS S3 (5GB free tier for 12 months)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bookmypanditji-assets
AWS_CLOUDFRONT_URL=

# Option 2: MinIO (Self-hosted, free) - Use with Docker
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=bookmypanditji

# Option 3: Cloudinary (25GB free): https://cloudinary.com/pricing
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# SEARCH (Free tier)
# ------------------------------------------------------------------
# Elasticsearch (Self-hosted with Docker) - Recommended
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Alternative: Meilisearch (Self-hosted, free)
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=

# ------------------------------------------------------------------
# MONITORING (Free tiers)
# ------------------------------------------------------------------
# Sentry (Free tier: 5k events/month): https://sentry.io/pricing/
SENTRY_DSN=

# ------------------------------------------------------------------
# EXTERNAL APIs (Free tiers)
# ------------------------------------------------------------------
# Utsav.gov.in for Live Darshan (Free government API)
UTSAV_API_BASE_URL=https://utsav.gov.in/api

# Google Maps (Free tier: $200/month credit)
# GOOGLE_MAPS_API_KEY=

# Panchang Calculation (Use Swiss Ephemeris - free library)
# Or implement own calculation

# ------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY_PRINT=true